# Copia este archivo a .env antes de correr docker compose.

# Configuración del Servidor JUB API
JUB_API_URL=http://localhost:5000
JUB_USERNAME=invitado
JUB_PASSWORD=invitado

# Modelo de Ollama a usar. Uno pequeño para que el tutorial sea rápido de
# descargar y correr en CPU; puedes cambiarlo por uno más grande si tienes
# GPU o quieres mejores respuestas (ej. "qwen3:4b", igual que jub-agent).
OLLAMA_MODEL=qwen2.5:1.5b

# URL del servidor Ollama. En docker-compose se sobreescribe automáticamente
# a http://ollama:11434 (nombre del servicio); esta variable es útil sobre
# todo para correr agent/main.py fuera de Docker, contra un Ollama local.
OLLAMA_URL=http://localhost:11434

# Puerto en el que escucha el servidor MCP.
MCP_PORT=8000

# URL completa del endpoint MCP (streamable-http). En docker-compose se
# sobreescribe a http://mcp-server:8000/mcp; útil para correr el agente
# fuera de Docker contra el mcp-server local.
MCP_SERVER_URL=http://localhost:8000/mcp
